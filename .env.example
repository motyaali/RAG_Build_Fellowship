# ===== OAF RAG Build Project — environment template =====
# Copy this file to `.env` and fill in the values for the providers you use.
# Only the API key for your active provider needs to be set.

# ----- Provider selection -----
# llm_provider:        gemini | openai | anthropic | ollama
# embeddings_provider: gemini | openai | ollama   | local | local_onnx
LLM_PROVIDER=gemini
EMBEDDINGS_PROVIDER=gemini

# ----- Model selection (provider-specific) -----
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDINGS_MODEL=gemini-embedding-2

# ----- API keys -----
# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — only if you switch LLM_PROVIDER above
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- Paths -----
DATA_DIR=data/workshop_corpus
CHROMA_PERSIST_DIR=.chroma

# ----- Retrieval defaults -----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ----- Ollama (only when LLM_PROVIDER=ollama) -----
OLLAMA_BASE_URL=http://localhost:11434
